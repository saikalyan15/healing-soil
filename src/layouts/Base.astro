---
import '../styles/global.css'
import { SITE, whatsappLink, MESSAGES } from '../config/site'

interface Props {
  title: string
  description: string
  image?: string
}
const { title, description, image = '/og-image.jpg' } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE.url).toString()
const ogImage = new URL(image, SITE.url).toString()
const sameAs = [SITE.socials.instagram, SITE.socials.facebook].filter(Boolean)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/logo.png', SITE.url).toString(),
  sameAs,
}
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script is:inline src="/analytics.js" defer></script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <nav aria-label="Main">
          <a href="/soaps">Soaps</a>
          <a href="/#herbs">Ingredients</a>
        </nav>
        <a class="wordmark" href="/">Healing Soil</a>
        <nav class="right" aria-label="Secondary">
          <a href="/wholesale">For businesses</a>
          <a href={whatsappLink(MESSAGES.general)} style="border-bottom:1px solid var(--ink)">WhatsApp</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="wordmark">Healing Soil</div>
        <div class="footer-links">
          <span>{SITE.region}</span>
          <a href={SITE.socials.instagram}>Instagram</a>
          {SITE.socials.facebook && <a href={SITE.socials.facebook}>Facebook</a>}
          <a href={whatsappLink()}>{SITE.whatsappDisplay}</a>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/soaps">Soaps</a>
          <a href="/gifting">Gifting</a>
          <a href="/wholesale">For businesses</a>
          <a href="/ingredients">Ingredients</a>
          <a href="/blog">Journal</a>
          <a href="/our-story">About</a>
          <a href="/faq">FAQ</a>
          <a href="/contact">Contact</a>
        </nav>
        <nav class="footer-links" aria-label="Policies">
          <a href="/shipping-policy">Shipping</a>
          <a href="/returns">Refunds</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
