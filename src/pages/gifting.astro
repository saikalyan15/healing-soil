---
import Base from '../layouts/Base.astro'
import { giftHampers, discoveryMosaic, formatRupees } from '../data/gift-hampers'
import { whatsappLink, MESSAGES } from '../config/site'
---
<Base
  title="Handmade soap gift hampers from ₹300 | Healing Soil"
  description="Four handmade soap gift hampers made to order: a jute bag set, a discovery box, a festive potli and a full set. See what is inside and order on WhatsApp."
  image="/images/gifting/jute-bag-card.webp"
>
  <section class="wrap section">
    <div class="section-head">
      <div>
        <div class="label">Gifting</div>
        <h1 class="h2">Gift hampers</h1>
      </div>
      <p>Four hampers, each made to order. Tell us who it is for and we will add a note. For many gifts at once, see <a href="/wholesale">soap squares for businesses</a>.</p>
    </div>
    <div class="sq-grid">
      {giftHampers.map((h) => (
        <div class="sq">
          {h.image
            ? <img class="photo" src={h.image.src} alt={h.image.alt} width="800" height="800" loading="lazy" style={`object-position:${h.image.position ?? '50% 50%'}`} />
            : <div class="mosaic">{discoveryMosaic.map((m) => <img class="photo" src={m.src} alt={m.alt} width="400" height="400" loading="lazy" />)}</div>}
          <div class="row"><span class="name">{h.name}</span></div>
          <p class="d">{h.summary}</p>
          <ul class="terms-list">{h.contents.map((c) => <li>{c}</li>)}</ul>
          {h.note && <p class="fine">{h.note}</p>}
          <div class="price"><span class="amt">{formatRupees(h.price)}</span><a class="link-line" href={whatsappLink(MESSAGES.bar(h.name))}>Order on WhatsApp</a></div>
        </div>
      ))}
    </div>
    <p class="fine">Hampers take 2 to 3 days to make, and delivery then takes about 4 to 7 days. Shipping is free on orders of ₹1,000 and above; below that it is ₹100, or ₹150 for the North India states.</p>
  </section>
</Base>
