---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { SITE, whatsappLink, MESSAGES, SHOW_PRICES } from '../config/site'
import { getSoap } from '../data/soaps'
import { formatINR } from '../data/pricing'

export async function getStaticPaths() {
  const pages = await getCollection('pages')
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }))
}

const { page } = Astro.props
const { Content } = await render(page)
const d = page.data
const url = new URL(`/${page.id}`, SITE.url).toString()
const items = d.products.map((s) => getSoap(s)).filter((s): s is NonNullable<typeof s> => !!s)
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: d.h1, item: url },
    ],
  },
]
if (d.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })
}
---
<Base title={d.title} description={d.description}>
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} slot="head" />)}
  <article class="wrap post">
    <header class="post-head">
      {d.updated && <div class="label">Last updated {d.updated}</div>}
      <h1 class="h2">{d.h1}</h1>
      {d.lead && <p class="lead-p" style="max-width:none">{d.lead}</p>}
    </header>
    <div class="prose"><Content /></div>
    {items.length > 0 && (
      <section class="faq" style="gap:24px">
        <h2 class="h2" style="font-size:clamp(28px,3vw,40px)">{d.productsTitle ?? 'The soaps'}</h2>
        <div class="bars">
          {items.map((s) => (
            <a class="bar" href={`/soaps/${s.slug}`}>
              {s.image ? <img class="photo" src={s.image} alt={`${s.name} soap bar`} width="800" height="800" loading="lazy" /> : <div class="ph" style="aspect-ratio:1/1">Photo to come</div>}
              <span class="cap"><span class="name">{s.name}</span><span class="base">{s.base}{s.weightGrams ? ` · ${s.weightGrams}g` : ''}</span>{SHOW_PRICES && <span class="price-line">{formatINR(s.price)}</span>}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    {d.faqs.length > 0 && (
      <section class="faq">
        <h2 class="h2" style="font-size:clamp(28px,3vw,40px)">Common questions</h2>
        {d.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}
    {d.cta !== 'none' && (
      <footer class="post-foot">
        {d.cta === 'soaps' && <a class="link-line" href="/soaps">See the soaps</a>}
        <a class={d.cta === 'whatsapp' ? 'btn' : 'link'} href={whatsappLink(MESSAGES.general)}>Order on WhatsApp</a>
      </footer>
    )}
  </article>
</Base>
