# Site posture. See src/lib/site-mode.ts.
#   full          the complete site (default)
#   content-only  no storefront: one-page landing at /, storefront routes 307 to
#                 /, blog + brand + legal pages stay live with buy CTAs removed,
#                 order APIs return 410
#   dark          only a holding page at /; everything else 307s to /
NEXT_PUBLIC_SITE_MODE=full

# SoapLedger machine-to-machine connection
SOAPLEDGER_API_URL=https://your-soapledger-domain.example
SOAPLEDGER_API_KEY=replace_me

# Razorpay Checkout and signed webhook
NEXT_PUBLIC_ENABLE_RAZORPAY=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Owner order email (comma-separated)
RESEND_API_KEY=re_replace_me
NOTIFY_EMAIL_TO=owner-one@example.com,owner-two@example.com

# Optional server-side analytics backups
META_CAPI_ACCESS_TOKEN=replace_me
GA4_MP_API_SECRET=replace_me
